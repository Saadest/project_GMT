root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{xml,xacro,urdf,srdf,launch}]
indent_size = 4

[*.{yaml,yml}]
indent_size = 2

[*.{json,md}]
indent_size = 2
trim_trailing_whitespace = false

[*.py]
indent_size = 4
max_line_length = 100

[*.{cpp,hpp,h,c}]
indent_size = 2

[*.msg]
indent_size = 4

[Makefile]
indent_style = tab
